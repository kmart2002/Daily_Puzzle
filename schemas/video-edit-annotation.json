{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/martykahn/media-ai-pipeline/schemas/video-edit-annotation.json",
  "title": "VideoEditAnnotation",
  "description": "Schema for annotating a single video editing decision for use as AI training data. Each annotation represents one editorial unit: a clip selection, a cut, a transition, or a color grade applied within a larger project.",
  "type": "object",
  "required": [
    "annotation_id",
    "schema_version",
    "created_at",
    "tool",
    "source_file",
    "edit_type",
    "clip",
    "quality_rating",
    "accepted"
  ],
  "additionalProperties": false,
  "properties": {
    "annotation_id": {
      "type": "string",
      "pattern": "^VID-[0-9]{8}-[0-9]{4}$",
      "description": "Unique identifier for this annotation. Format: VID-YYYYMMDD-NNNN",
      "examples": ["VID-20240315-0001"]
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Version of this annotation schema. Pin to exact version for reproducibility."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this annotation was created."
    },
    "annotator": {
      "type": "string",
      "description": "Name or ID of the human annotator who created or reviewed this entry."
    },
    "tool": {
      "type": "object",
      "description": "The editing tool used to produce this edit.",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": ["Shotcut", "OpenShot", "Lightworks", "DaVinci Resolve", "Kdenlive", "Other"],
          "description": "Name of the NLE or color grading tool."
        },
        "version": {
          "type": "string",
          "description": "Exact version string as reported by the tool (e.g., '23.11.29').",
          "examples": ["23.11.29", "0.3.0", "2023.2"]
        },
        "platform": {
          "type": "string",
          "enum": ["Windows", "macOS", "Linux"],
          "description": "Operating system on which the edit was performed."
        },
        "project_file": {
          "type": "string",
          "description": "Path or anonymized reference to the native project file (MLT, OSP, etc.).",
          "examples": ["project-20240315-001.mlt", "project-20240315-001.osp"]
        }
      }
    },
    "source_file": {
      "type": "object",
      "description": "Reference to the source media from which this clip was taken.",
      "required": ["reference_id", "duration_seconds", "frame_rate", "resolution"],
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "type": "string",
          "description": "Anonymized or hashed identifier for the source media file.",
          "examples": ["src-a3f2c1d9", "footage-20240315-CAM1"]
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Total duration of the source file in seconds."
        },
        "frame_rate": {
          "type": "number",
          "enum": [23.976, 24, 25, 29.97, 30, 48, 50, 59.94, 60],
          "description": "Frame rate of the source media in frames per second."
        },
        "resolution": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "description": "Resolution of the source media in pixels."
        },
        "codec": {
          "type": "string",
          "description": "Video codec of the source file.",
          "examples": ["H.264", "H.265", "ProRes 422", "DNxHD"]
        }
      }
    },
    "edit_type": {
      "type": "string",
      "enum": [
        "rough_cut",
        "fine_cut",
        "color_grade",
        "color_correction",
        "transition",
        "title_card",
        "stabilization",
        "speed_ramp",
        "multicam_sync",
        "export_master"
      ],
      "description": "The primary category of editorial decision this annotation captures."
    },
    "clip": {
      "type": "object",
      "description": "Timecode and positional information for the annotated clip segment.",
      "required": ["in_point", "out_point", "timeline_position"],
      "additionalProperties": false,
      "properties": {
        "in_point": {
          "type": "object",
          "description": "The point in the source file where this clip begins.",
          "required": ["seconds", "frame"],
          "properties": {
            "seconds": { "type": "number", "minimum": 0 },
            "frame": { "type": "integer", "minimum": 0 },
            "timecode": {
              "type": "string",
              "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}:[0-9]{2}$",
              "description": "SMPTE timecode HH:MM:SS:FF",
              "examples": ["00:01:23:12"]
            }
          }
        },
        "out_point": {
          "type": "object",
          "description": "The point in the source file where this clip ends.",
          "required": ["seconds", "frame"],
          "properties": {
            "seconds": { "type": "number", "minimum": 0 },
            "frame": { "type": "integer", "minimum": 0 },
            "timecode": {
              "type": "string",
              "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}:[0-9]{2}$",
              "examples": ["00:01:31:05"]
            }
          }
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Computed duration of this clip (out_point.seconds - in_point.seconds)."
        },
        "timeline_position": {
          "type": "object",
          "description": "Where this clip sits on the output timeline.",
          "required": ["start_seconds", "track"],
          "properties": {
            "start_seconds": { "type": "number", "minimum": 0 },
            "track": {
              "type": "string",
              "description": "Track label or number (e.g., 'V1', 'Video Track 2').",
              "examples": ["V1", "V2", "Video Track 1"]
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "description": "Transition applied at the out-point of this clip (if any).",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "cut",
            "dissolve",
            "fade_to_black",
            "fade_from_black",
            "wipe_left",
            "wipe_right",
            "wipe_up",
            "wipe_down",
            "push",
            "slide",
            "dip_to_white",
            "luma_wipe",
            "none"
          ]
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1,
          "description": "Duration of the transition in frames."
        },
        "easing": {
          "type": "string",
          "enum": ["linear", "ease_in", "ease_out", "ease_in_out"],
          "description": "Easing curve applied to the transition."
        }
      }
    },
    "color_grade": {
      "type": "object",
      "description": "Color grading parameters applied to this clip. Only required when edit_type is 'color_grade' or 'color_correction'.",
      "additionalProperties": false,
      "properties": {
        "lift": {
          "type": "object",
          "description": "Shadow lift (black point adjustment) per channel.",
          "properties": {
            "r": { "type": "number", "minimum": -1, "maximum": 1 },
            "g": { "type": "number", "minimum": -1, "maximum": 1 },
            "b": { "type": "number", "minimum": -1, "maximum": 1 },
            "master": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        },
        "gamma": {
          "type": "object",
          "description": "Midtone gamma per channel.",
          "properties": {
            "r": { "type": "number", "minimum": 0, "maximum": 4 },
            "g": { "type": "number", "minimum": 0, "maximum": 4 },
            "b": { "type": "number", "minimum": 0, "maximum": 4 },
            "master": { "type": "number", "minimum": 0, "maximum": 4 }
          }
        },
        "gain": {
          "type": "object",
          "description": "Highlight gain (white point adjustment) per channel.",
          "properties": {
            "r": { "type": "number", "minimum": 0, "maximum": 4 },
            "g": { "type": "number", "minimum": 0, "maximum": 4 },
            "b": { "type": "number", "minimum": 0, "maximum": 4 },
            "master": { "type": "number", "minimum": 0, "maximum": 4 }
          }
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Saturation multiplier. 1.0 = unchanged."
        },
        "contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Contrast multiplier. 1.0 = unchanged."
        },
        "temperature_kelvin": {
          "type": "number",
          "minimum": 1000,
          "maximum": 20000,
          "description": "White balance color temperature in Kelvin."
        },
        "tint": {
          "type": "number",
          "minimum": -100,
          "maximum": 100,
          "description": "Tint shift (green-magenta axis). 0 = neutral."
        },
        "lut_applied": {
          "type": "string",
          "description": "Name of the LUT applied, if any.",
          "examples": ["FilmLook_Kodak2383.cube", "None"]
        },
        "hsl_curves": {
          "type": "object",
          "description": "Hue, saturation, and luminance curve adjustments.",
          "properties": {
            "hue_vs_hue": { "type": "array", "items": { "type": "number" } },
            "hue_vs_sat": { "type": "array", "items": { "type": "number" } },
            "hue_vs_lum": { "type": "array", "items": { "type": "number" } },
            "lum_vs_sat": { "type": "array", "items": { "type": "number" } }
          }
        }
      }
    },
    "editorial_notes": {
      "type": "string",
      "description": "Free-text notes from the editor explaining the decision-making behind this cut or grade. Valuable for NLP-augmented training pipelines.",
      "maxLength": 2000
    },
    "pacing_context": {
      "type": "object",
      "description": "Context about the clip's role in the pacing and rhythm of the sequence.",
      "additionalProperties": false,
      "properties": {
        "position_in_sequence": {
          "type": "string",
          "enum": ["opening", "early", "mid", "climax", "resolution", "closing"],
          "description": "Narrative position of this clip within the overall sequence."
        },
        "cut_rhythm": {
          "type": "string",
          "enum": ["slow", "medium", "fast", "variable"],
          "description": "Overall pacing of cuts in the surrounding context."
        },
        "preceded_by": {
          "type": "string",
          "enum": ["cut", "dissolve", "fade", "hard_start", "unknown"],
          "description": "Type of transition that leads into this clip."
        }
      }
    },
    "quality_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Human quality rating. 1=unusable, 2=poor, 3=acceptable, 4=good, 5=exemplary. Only ratings ≥3 should be used as positive training examples."
    },
    "accepted": {
      "type": "boolean",
      "description": "Whether this annotation is accepted for use in the training dataset. Must be false if quality_rating < 3."
    },
    "rejection_reason": {
      "type": "string",
      "enum": [
        "jump_cut_unintentional",
        "exposure_out_of_range",
        "motion_blur_excessive",
        "audio_sync_drift",
        "color_inconsistency",
        "duplicate_of_existing",
        "source_quality_too_low",
        "metadata_incomplete",
        "out_of_focus",
        "unwanted_object_in_frame",
        "encoder_artifact",
        "frame_rate_mismatch",
        "annotator_error",
        "other"
      ],
      "description": "Required when accepted=false. Controlled vocabulary for rejection reasons to enable systematic filtering and analysis."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Optional free-form tags for retrieval and filtering.",
      "examples": [["interview", "indoor", "handheld", "natural_light"]]
    }
  },
  "if": {
    "properties": { "accepted": { "const": false } }
  },
  "then": {
    "required": ["rejection_reason"]
  }
}
