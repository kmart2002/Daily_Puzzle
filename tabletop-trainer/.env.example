# ---------------------------------------------------------------------------
# Frontend (Vite). Anything prefixed VITE_ is INLINED INTO THE PUBLIC BUNDLE.
# Only ever put public values here — never a service-role key or API secret.
# ---------------------------------------------------------------------------

# Base URL of the deployed Supabase Edge Functions, e.g.
# https://<project-ref>.supabase.co/functions/v1
VITE_API_URL=

# ---------------------------------------------------------------------------
# Server-side only (Supabase Edge Function secrets). These are set with
#   supabase secrets set KEY=value
# and are NEVER prefixed VITE_ and NEVER committed with real values.
# ---------------------------------------------------------------------------

# Transactional email provider (Resend).
RESEND_API_KEY=re_your_key_here
MAIL_FROM=Tabletop Trainer <puzzles@yourdomain.com>
# Physical sender identity shown in the footer (CAN-SPAM requirement).
MAIL_SENDER_ADDRESS=Tabletop Trainer, 1 Example St, Somewhere

# HMAC secret signing the per-day play links in the daily email.
# Generate with: openssl rand -base64 32
PLAY_TOKEN_SECRET=

# Shared secret the scheduler sends as the x-cron-secret header on /send-daily.
CRON_SECRET=

# Public URLs used to build links inside emails.
PUBLIC_APP_URL=https://kmart2002.github.io/Daily_Puzzle/tabletop-trainer/
PUBLIC_FUNCTIONS_URL=
# Restrict browser CORS to the site origin ('*' is fine for local dev).
ALLOWED_ORIGIN=https://kmart2002.github.io

# Injected automatically by the Supabase platform — do not set by hand:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
