# Phase 2 only — the MVP needs no environment variables.
#
# The Claude-powered coach narrative runs on a server/edge proxy, NEVER in the
# browser bundle. This key must only ever be set in the proxy's environment.
# Do not prefix it with VITE_ (that would inline it into client code).
ANTHROPIC_API_KEY=sk-ant-your-key-here-do-not-commit-real-keys
